# 1) Secretos: bloquea el commit si gitleaks detecta credenciales en lo staged.
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --staged --redact --no-banner || exit 1
else
  echo "⚠️  gitleaks no instalado: escaneo local de secretos omitido (la CI lo ejecuta)."
  echo "   Instálalo: brew install gitleaks"
fi

# 2) Calidad: lint de los archivos modificados.
npx lint-staged
